local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- BẢNG MÀU GLITCHNOODLE
local Theme = {
    Main = Color3.fromRGB(15, 10, 25),      -- Nền chính
    Second = Color3.fromRGB(25, 20, 40),    -- Nền phụ (Button/Tab)
    Stroke = Color3.fromRGB(180, 50, 255),  -- Viền Tím Neon
    Text = Color3.fromRGB(255, 255, 255),    -- Chữ trắng
    TextDark = Color3.fromRGB(180, 150, 255)-- Chữ tím nhạt
}

-- [1. HỆ THỐNG CHỐNG TRÙNG LẶP]
local GUI_NAME = "GlitchNoodle_Final_UI"
local CoreGui = (gethui and gethui()) or game:GetService("CoreGui")
if CoreGui:FindFirstChild(GUI_NAME) then
    CoreGui[GUI_NAME]:Destroy()
end

-- [2. KHỞI TẠO GUI GỐC]
local Orion = Instance.new("ScreenGui")
Orion.Name = GUI_NAME
Orion.Parent = CoreGui
Orion.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local function Create(Name, Props, Children)
    local Obj = Instance.new(Name)
    for i, v in pairs(Props or {}) do Obj[i] = v end
    for _, child in pairs(Children or {}) do child.Parent = Obj end
    return Obj
end

local OrionLib = {}

function OrionLib:MakeWindow(Config)
    local Window = {Tabs = {}}
    local WindowTitle = Config.Name or "GLITCHNOODLE HUB"

    -- Nút Restore (Nút bật lại khi đã ẩn)
    local RestoreBtn = Create("TextButton", {
        Parent = Orion,
        Visible = false,
        Size = UDim2.new(0, 45, 0, 45),
        Position = UDim2.new(1, -55, 0.5, -22),
        BackgroundColor3 = Theme.Main,
        Text = "GN",
        Font = Enum.Font.GothamBlack,
        TextColor3 = Theme.Stroke,
        TextSize = 16,
    }, {
        Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
        Create("UIStroke", {Color = Theme.Stroke, Thickness = 2})
    })

    -- Frame Chính
    local MainFrame = Create("Frame", {
        Parent = Orion,
        Position = UDim2.new(0.5, -250, 0.5, -175),
        Size = UDim2.new(0, 500, 0, 350),
        BackgroundColor3 = Theme.Main,
        ClipsDescendants = true,
        BorderSizePixel = 0
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
        Create("UIStroke", {Color = Theme.Stroke, Thickness = 2})
    })

    -- TopBar (Thanh tiêu đề)
    local TopBar = Create("Frame", {
        Parent = MainFrame,
        Size = UDim2.new(1, 0, 0, 45),
        BackgroundTransparency = 1
    })

    local TitleLabel = Create("TextLabel", {
        Parent = TopBar,
        Text = "   " .. WindowTitle:upper(),
        Size = UDim2.new(1, -80, 1, 0),
        Font = Enum.Font.GothamBlack,
        TextColor3 = Theme.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1
    })

    -- Nút Thu Nhỏ (-)
    local MinBtn = Create("TextButton", {
        Parent = TopBar,
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -40, 0.5, -15),
        BackgroundColor3 = Theme.Second,
        Text = "-",
        Font = Enum.Font.GothamBold,
        TextColor3 = Theme.Text,
        TextSize = 20,
        AutoButtonColor = true
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 6)})
    })

    -- Sidebar (Chứa Tab)
    local Sidebar = Create("ScrollingFrame", {
        Parent = MainFrame,
        Position = UDim2.new(0, 10, 0, 55),
        Size = UDim2.new(0, 120, 1, -65),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, {
        Create("UIListLayout", {Padding = UDim.new(0, 5)})
    })

    -- Container (Chứa nội dung)
    local Container = Create("Frame", {
        Parent = MainFrame,
        Position = UDim2.new(0, 140, 0, 55),
        Size = UDim2.new(1, -150, 1, -65),
        BackgroundTransparency = 1
    })

    -- LOGIC NÚT TẮT (-) HOẠT ĐỘNG
    MinBtn.MouseButton1Click:Connect(function()
        MainFrame:TweenSize(UDim2.new(0, 500, 0, 0), "Out", "Quint", 0.4, true)
        task.wait(0.4)
        MainFrame.Visible = false
        RestoreBtn.Visible = true
    end)

    RestoreBtn.MouseButton1Click:Connect(function()
        RestoreBtn.Visible = false
        MainFrame.Visible = true
        MainFrame:TweenSize(UDim2.new(0, 500, 0, 350), "Out", "Quint", 0.4, true)
    end)

    -- Kéo thả Menu
    local Dragging, DragInput, MousePos, FramePos
    TopBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true MousePos = i.Position FramePos = MainFrame.Position
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then Dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement and Dragging then
            local Delta = i.Position - MousePos
            MainFrame.Position = UDim2.new(FramePos.X.Scale, FramePos.X.Offset + Delta.X, FramePos.Y.Scale, FramePos.Y.Offset + Delta.Y)
        end
    end)

    -- [HÀM TẠO TAB]
    function Window:MakeTab(Name)
        local Tab = {}
        local Page = Create("ScrollingFrame", {
            Parent = Container,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Stroke,
            AutomaticCanvasSize = Enum.AutomaticSize.Y
        }, {
            Create("UIListLayout", {Padding = UDim.new(0, 8)})
        })

        local TBtn = Create("TextButton", {
            Parent = Sidebar,
            Size = UDim2.new(1, 0, 0, 35),
            BackgroundColor3 = Theme.Second,
            Text = Name,
            Font = Enum.Font.GothamBold,
            TextColor3 = Theme.TextDark,
            TextSize = 12
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 6)})
        })

        TBtn.MouseButton1Click:Connect(function()
            for _, v in pairs(Container:GetChildren()) do v.Visible = false end
            for _, v in pairs(Sidebar:GetChildren()) do 
                if v:IsA("TextButton") then v.TextColor3 = Theme.TextDark v.BackgroundColor3 = Theme.Second end 
            end
            Page.Visible = true
            TBtn.TextColor3 = Theme.Stroke
            TBtn.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
        end)

        -- Tab mặc định
        if #Sidebar:GetChildren() == 2 then 
            Page.Visible = true 
            TBtn.TextColor3 = Theme.Stroke 
            TBtn.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
        end

        -- [ELEMENT: BUTTON]
        function Tab:AddButton(BtnName, Callback)
            local B = Create("TextButton", {
                Parent = Page,
                Size = UDim2.new(1, -5, 0, 38),
                BackgroundColor3 = Theme.Second,
                Text = "  " .. BtnName,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
                Create("UIStroke", {Color = Theme.Stroke, Thickness = 0.5})
            })
            B.MouseButton1Click:Connect(function()
                pcall(Callback)
                B.BackgroundColor3 = Theme.Stroke
                task.wait(0.1)
                B.BackgroundColor3 = Theme.Second
            end)
        end

        -- [ELEMENT: TOGGLE]
        function Tab:AddToggle(TglName, Default, Callback)
            local Toggled = Default or false
            local TglBtn = Create("TextButton", {
                Parent = Page,
                Size = UDim2.new(1, -5, 0, 38),
                BackgroundColor3 = Theme.Second,
                Text = "  " .. TglName,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.TextDark,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 6)})
            })

            local Ind = Create("Frame", {
                Parent = TglBtn,
                Position = UDim2.new(1, -35, 0.5, -10),
                Size = UDim2.new(0, 20, 0, 20),
                BackgroundColor3 = Toggled and Theme.Stroke or Color3.fromRGB(60, 60, 60)
            }, {
                Create("UICorner", {CornerRadius = UDim.new(1, 0)})
            })

            TglBtn.MouseButton1Click:Connect(function()
                Toggled = not Toggled
                TweenService:Create(Ind, TweenInfo.new(0.2), {BackgroundColor3 = Toggled and Theme.Stroke or Color3.fromRGB(60, 60, 60)}):Play()
                pcall(Callback, Toggled)
            end)
        end

        return Tab
    end

    return Window
end

